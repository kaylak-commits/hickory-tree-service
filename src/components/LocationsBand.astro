---
/* Shows the full service area so a visitor can see we cover their town.
   Towns with a page are links; towns still being written render as plain
   text — visible, but never a broken link. */
import { getCollection } from 'astro:content';
import { IMAGES, LOCATIONS, bandSrc, type ImageKey } from '../config';

/* `linked` is false on the HOMEPAGE only. Site map rule: the homepage body
   links to the 3 money pages and nothing else, so the towns show as places we
   serve, in plain text. Every other page links them normally. */
interface Props { heading?: string; bg?: string; linked?: boolean; }
const { heading = 'Towns We Serve Across Catawba County', bg: bgKey = 'landClearing',
        linked = true } = Astro.props;

const built = new Set((await getCollection('locations')).map((l) => l.id));
const pic = (IMAGES[bgKey as ImageKey] ?? IMAGES.heroCrew) as { src: string; pos?: string };
const bg = `background-image:linear-gradient(rgba(12,21,34,.88),rgba(12,21,34,.92)),url('${bandSrc(pic.src)}');background-position:${pic.pos ?? 'center 55%'}`;
---
<section class="locs" id="locations" style={bg}>
  <div class="wrap">
    <h2>{heading}</h2>
    <ul>
      {LOCATIONS.map((l) => {
        const slug = l.slug.replace(/^\//, '').replace(/\/$/, '');
        return (linked && built.has(slug))
          ? <li><a href={l.slug}>{l.name}, NC</a></li>
          : <li><span class={built.has(slug) ? undefined : 'soon'}>{l.name}, NC</span></li>;
      })}
    </ul>
  </div>
</section>
