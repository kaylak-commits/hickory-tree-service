---
/* Nav with real dropdowns. Both menus are generated from the content
   collections, so a page appears in the menu the moment its markdown file
   exists — and a menu can never point at a page that doesn't. */
import { getCollection } from 'astro:content';
import { SITE, IMAGES, HAS_PHONE } from '../config';

/* Three menus, driven by fields the content schema already defines:
     - Services:       inMenu === true (the money + main tier)
     - Other Services:  layer === 'longtail' (long-tail service pages —
                         Kayla, 2026-09-08: these get their own nav menu so
                         Google can crawl them from every page on first
                         pass; fold this menu away once the site is crawled
                         and each page has inbound links from elsewhere)
     - Locations:       the locations collection, with the service-areas
                         hub page (still filed in the services collection)
                         pinned at the top
   A page appears in a menu the moment its frontmatter says so — no menu
   can point at a page that doesn't exist. */
const allServices = await getCollection('services');
const services = allServices
  .filter((s) => s.data.inMenu)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const otherServices = allServices
  .filter((s) => s.data.layer === 'longtail')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const serviceAreasHub = allServices.find((s) => s.id === 'service-areas');
const locations = (await getCollection('locations')).sort((a, b) =>
  a.data.town.localeCompare(b.data.town)
);
---
<header>
  <div class="wrap bar">
    {/* Kayla, 2026-09-08: prefers the plain icon (no banner text) with the
        brand name set as real text beside it, rather than the small curved
        text baked into the circular badge graphic. */}
    <a class="logo" href="/">
      <img src="/logo-icon.webp" alt="" width="200" height="200" />
      <span class="logo-text">Tree Service<br/>Hickory NC</span>
    </a>

    <input type="checkbox" id="nt" />
    <label class="burger" for="nt" aria-label="Menu">☰</label>

    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about/">About</a></li>

        <li class="has-sub">
          <a href="/services/">Services <span class="caret">▾</span></a>
          <ul class="sub">
            {services.map((s) => (
              <li><a href={`/${s.id}/`}>{s.data.h1.replace(SITE.h1Suffix, '')}</a></li>
            ))}
            <li class="sub-all"><a href="/services/">All services →</a></li>
          </ul>
        </li>

        {otherServices.length > 0 && (
          <li class="has-sub">
            <a href="/services/">Other Services <span class="caret">▾</span></a>
            <ul class="sub">
              {otherServices.map((s) => (
                <li><a href={`/${s.id}/`}>{s.data.h1.replace(SITE.h1Suffix, '')}</a></li>
              ))}
              <li class="sub-all"><a href="/services/">All services →</a></li>
            </ul>
          </li>
        )}

        <li class="has-sub">
          <a href="/service-areas/">Locations <span class="caret">▾</span></a>
          <ul class="sub">
            {serviceAreasHub && (
              <li><a href={`/${serviceAreasHub.id}/`}>All Service Areas</a></li>
            )}
            {locations.map((l) => (
              <li><a href={`/${l.id}/`}>Tree Service in {l.data.town}, NC</a></li>
            ))}
          </ul>
        </li>

        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div class="callbox">
      {HAS_PHONE
        ? <a class="phone" href={SITE.phoneHref}>📞 {SITE.phone}</a>
        : <a class="phone" href="/contact/">✉️ Request a Quote</a>}
      <div class="creds" set:html={SITE.credentials.join('<br>')} />
    </div>
  </div>
</header>
