---
interface Props { items: { q: string; a: string }[]; heading?: string; }
const { items, heading } = Astro.props;
---
<section class="faq">
  <div class="wrap">
    {heading && <h2>{heading}</h2>}
    {items.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <div class="a"><p set:html={f.a} /></div>
      </details>
    ))}
  </div>
</section>
