---
import { SITE, HAS_PHONE, HAS_EMAIL, ESTIMATE_LINE } from '../config';
const year = 2026;
const addr = SITE.address.street
  ? `${SITE.address.street}, ${SITE.address.city}, ${SITE.address.state} ${SITE.address.zip}`
  : `${SITE.address.city}, ${SITE.address.state}`;
---
<footer>
  <div class="wrap">
    <div class="fg">
      <div>
        <h4>{SITE.brand}</h4>
        <p>{SITE.footerBlurb} {ESTIMATE_LINE} Removal from {SITE.minCallout}.</p>
        <p style="font-size:.86rem">{SITE.disclosure}</p>
      </div>
      <div>
        <h4>Contact</h4>
        <p>
          {HAS_PHONE && <><a href={SITE.phoneHref}>{SITE.phone}</a><br /></>}
          {HAS_EMAIL && <><a href={`mailto:${SITE.email}`}>{SITE.email}</a><br /></>}
          {!HAS_PHONE && !HAS_EMAIL && <><a href="/contact/">Request a quote</a><br /></>}
          {addr}
        </p>
      </div>
      <div>
        <h4>Services</h4>
        <p>Tree Removal · Tree Trimming · Stump Grinding · Land Clearing · Storm Damage · Arborist Services</p>
      </div>
    </div>
    <div class="fine">
      © {year} {SITE.brand} · {SITE.disclosure}<br />
      <a href="/privacy-policy/">Privacy Policy</a> ·
      <a href="/terms-and-conditions/">Terms &amp; Conditions</a> ·
      <a href="/services/">All Services</a>
    </div>
  </div>
</footer>
