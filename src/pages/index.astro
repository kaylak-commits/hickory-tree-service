const closeBody = `<p>Removal starts at $500 and trimming runs $500 to $2,500, with the number in writing before
anything is cut. Licensed and insured, free estimates, and the same pricing across Hickory
and the rest of Catawba County.</p>
<p>Call Tree Service Hickory NC at (828) 522-9430, or send the details and we'll come look.</p>`;

const faqs = [
  { q: `How much does tree service cost in Hickory, NC?`, a: `Removal starts at a $500 minimum, and most jobs run $500 to $3,000 depending on tree size and access. Trimming runs $500 to $2,500 depending on scope, stump grinding starts at $150, and land clearing runs $2,500 to $12,000 or more per acre. Every job gets a written price before a saw starts, so the number is never a surprise once the work begins.` },
  { q: `Do you handle emergency storm damage?`, a: `Yes. A tree down on a house, a car or a driveway gets handled the way access allows. Cost runs $2,000 to $20,000, driven mainly by damage and access rather than a flat rate.` },
  { q: `Do I need a permit to remove a tree on my own property in Hickory?`, a: `No. Ordinary residential tree removal on a single-family or two-family lot does not require a city permit under Hickory's Land Development Code. A permit applies only to a tree in a public right-of-way or a job tied to new commercial construction, and we handle that permit when it's needed.` },
  { q: `What towns do you serve?`, a: `Hickory and the rest of Catawba County. No separate travel charge applies to the towns outside Hickory.` },
  { q: `Are you licensed and insured?`, a: `Yes, on every job, residential and commercial.` },
  { q: `What's the difference between tree trimming and tree removal?`, a: `Trimming cuts back limbs and leaves the tree standing. Removal takes the whole tree down. A tree that looks stressed rather than obviously dead is usually a trimming or an assessment question first, not an automatic removal.` },
  { q: `Do you grind stumps left behind by another crew?`, a: `Yes, single stumps, several from the same removal, or ones another crew left. All of them get ground flush below grade starting at $150.` },
  { q: `What does land clearing cost in Hickory?`, a: `$2,500 to $12,000 or more per acre, depending on vegetation and access. Every job starts with a walk of the property to mark what stays and what comes out, then a written price by the acre.` },
  { q: `Do you offer certified arborist assessments?`, a: `Yes. An ISA-certified arborist assessment, worked to ANSI A300, starts at $250. It covers a tree health diagnosis, a risk assessment, or a written treatment recommendation before anyone decides to remove instead of treat.` },
  { q: `Why do trees uproot here instead of just losing limbs?`, a: `Sandy loam soil drains fast but still saturates during Hickory's roughly 45 inches of annual rain, which loosens root anchorage on a saturated lot. A shallow-rooted species like loblolly pine is the most common one this affects.` },
  { q: `Can you tell me which service I actually need before I call?`, a: `Usually, yes, over the phone, once we know what the tree looks like and what's near it. A short description and a photo if you have one is often enough to point you toward removal, trimming, an assessment, or cabling and bracing before a crew ever comes out.` },
  { q: `Do you offer financing or payment plans for larger jobs?`, a: `Larger jobs like land clearing or a multi-tree removal are quoted as one written price before work starts. Payment terms for a job that size get discussed at the estimate, not assumed ahead of time.` },
  { q: `What happens to the wood after a tree comes down?`, a: `Debris hauling and chipping is part of most removals, and it's often included in the $500 minimum rather than billed as a separate line. Larger trunk sections can sometimes be left on site if you want the firewood, which is worth mentioning at the estimate.` }
];
---
<BaseLayout
  title={`Tree Service Hickory NC | Removal, Trimming & Storm Damage`}
  description="Tree Service Hickory NC covers removal, trimming and storm damage across Catawba County. Removal from $500. Licensed and insured. Free estimate."
  business={true}
  faqs={faqs}
>

  {/* 1 — opener. Two paragraphs plus the CTA line, then the form, both above the fold. */}
  <section class="hero" style={heroStyle}>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hcard">
          <span class="tag">REMOVAL · TRIMMING · STORM DAMAGE</span>
          <h1>Tree Service in Hickory, NC</h1>
          <div class="lede" set:html={opener} />
        </div>
        <QuoteForm heading="Get a Free Estimate" source="homepage" />
      </div>
    </div>
  </section>

  {/* 2 — the three money pages, verbatim from copy/homepage.md */}
  <section class="cream">
    <div class="wrap">
      <article class="prose" set:html={secServices} />
    </div>
  </section>

  {/* 3 — photo band with the primary ask. */}
