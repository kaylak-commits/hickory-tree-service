      <article class="prose narrow steps" set:html={secProcess} />
    </div>
  </section>

  {/* 8 — why us. */}
  <section class="cream">
    <div class="wrap">
      <article class="prose narrow" set:html={secWhyChoose} />
    </div>
  </section>

  {/* 9 — service area. */}
  <section>
    <div class="wrap">
      <article class="prose narrow" set:html={secServiceArea} />
    </div>
  </section>

  {/* 10 — service area band, FAQ, close. */}
  <LocationsBand bg="landClearing" linked={false} />

  <Faq items={faqs} heading="Tree Service Questions We Get Asked in Hickory" />

  <section class="close">
    <div class="wrap">
      <div class="t2">Get Your Tree Service Job Quoted</div>
      <div set:html={closeBody} />
      {SHOW_CALL_CTA && (
        <div class="cta-row" style="margin-top:24px">
          <a class="cta" href={CALL_CTA.href}>{CALL_CTA.label}</a>
          <a class="cta ghost" href="#quote">Get a Free Estimate</a>
