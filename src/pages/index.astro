      </div>
    </div>
  </section>

  {/* 4 — full-service tree care, named but not linked (long-tail layer). */}
  <section>
    <div class="wrap">
      <article class="prose narrow" set:html={secFullService} />
    </div>
  </section>

  {/* 5 — photo alongside a short block */}
  <div class="imgrow">
    <div class="ph">
      <img src={IMAGES.trimming.src} alt={IMAGES.trimming.alt} width="1600" height="1000" loading="lazy" />
    </div>
    <div class="txt">
      <div class="t3">One crew, one quote</div>
      <p>Cutting, rigging, hauling and cleanup run as one job on one schedule, rather than a
      crew that drops the wood and leaves the cleanup to you.</p>
      <p style="margin-top:20px"><a class="cta" href="#quote">Get a Free Estimate</a></p>
    </div>
  </div>

  {/* 6 — the local angle. Climate and soil, because both are sourceable. */}
  <section class="cream">
    <div class="wrap">
