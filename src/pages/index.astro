import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import LocationsBand from '../components/LocationsBand.astro';
import Faq from '../components/Faq.astro';
import { SITE, IMAGES, CALL_CTA, SHOW_CALL_CTA } from '../config';

const heroStyle = `background-image:linear-gradient(rgba(20,32,48,.55),rgba(20,32,48,.68)),url('${IMAGES.heroCrew.src}')`;
const bandStyle = `background-image:linear-gradient(rgba(20,32,48,.58),rgba(20,32,48,.70)),url('${IMAGES.storm.src}')`;

const opener = `<p>Tree Service Hickory NC removes, trims and clears trees for homeowners, landlords and
small commercial properties across Hickory and Catawba County. A standing dead loblolly
pine leaning toward a fence, a red maple splitting at a codominant trunk after a storm, or
a tree already down on a roof, one crew handles all of it. Every job gets a written price
before a saw starts, whether it's a single hazardous white oak or a yard full of sweetgum
and tulip poplar.</p>
<p>We work on single-family lots, rental properties and small commercial sites. Equipment is
sized to the job: a bucket truck and ground crew for open-yard work, climbing gear and
rigging near a structure or power line, and a crane for large or technical drops. Southern
pine beetle, oak wilt and verticillium wilt are all real, local reasons a tree gets
flagged for removal instead of trimming. The crew can tell you which one applies to your
tree, and why, before anything comes down. Removal starts at $500, and trimming runs $500
to $2,500. Licensed and insured, with the same pricing whether the call comes from
Hickory, Conover, Newton, Longview, Maiden, Claremont or the rest of Catawba County.</p>
<p><a href="#quote">Get a Free Estimate</a> · <a href="tel:+18285229430">Call (828) 522-9430</a></p>`;
const secServices = `<h2>Tree Services in Hickory and Catawba County</h2>
<h3><a href="/tree-removal/">Tree Removal</a></h3>
<p>Whole-tree drops in open yards, climbing jobs beside a house or power line, and crane work
for large or hazardous trees. Every removal starts with a site inspection to plan the drop
or the rigging, followed by a written price before any saw starts. Standing dead pines,
storm-weakened oaks, and healthy trees that simply need to come out for a new build or a
view all get the same process: assess the lean and the root condition, quote it in
writing, then fell or section it depending on what's around it. A whole tree drops in one
piece in an open yard. Anything near a house, a fence or a power line comes down in
sections instead, roped and lowered rather than let fall. The stump gets ground the same
day if you want it gone, and everything cut gets hauled or chipped before the crew leaves.
From $500, with most jobs landing between $500 and $3,000 depending on the tree's size and
how hard it is to reach.</p>
<h3><a href="/tree-trimming/">Tree Trimming</a></h3>
<p>Structural pruning on young trees, canopy thinning on mature ones, deadwood removal, and
clearance cuts away from a roofline or power line. A bucket truck handles most clearance
and canopy work, and climbing gear comes out for limbs a truck can't reach. The point of
structural pruning while a tree is young is correcting a weak union, a codominant trunk or
included bark, before it becomes a removal problem ten years later. On a mature tree,
thinning a heavy, top-heavy canopy is what lets it shed wind and rain weight in a storm
instead of losing a limb or going over at the roots. Every cut gets hauled away before the
crew leaves. Trimming usually runs $500 to $2,500 depending on scope, tree size and how
much climbing the job needs.</p>
<h3><a href="/emergency-storm-damage-tree-removal/">Emergency Storm Damage Removal</a></h3>
<p>A tree resting on a roof gets rigged and sectioned differently than one already down in
the yard, and the crew plans for whichever one shows up. A tree that's already fallen and
clear of a structure is usually the faster job: section it, haul it, done. A tree still
resting against a house, a car or a power line has to be assessed for the load it's
putting on whatever it landed on before a single cut gets made, because cutting the wrong
piece first can drop the load the wrong way. Response covers homes, cars, driveways and
yards, with the crew working around downed power lines and structural damage rather than
around either one alone. Cost is driven mainly by damage and access, running $2,000 to
$20,000.</p>`;
const secFullService = `<h2>Full-Service Tree Care</h2>
<p>Beyond removal, trimming and storm response, the crew also covers the rest of what a
Catawba County property actually needs. Stump grinding starts at $150 and grinds it flush below grade, whether it's one left from today's job or several from an earlier removal, including work another crew did. Land clearing runs $2,500 to $12,000 or more per
acre for a build site, a driveway or a pasture, cleared tree by tree rather than pushed in
bulk so what stays gets marked and kept. Hazardous tree removal, for a standing dead or
visibly leaning tree, runs $500 to $9,000 or more depending on lean and location relative
to a structure. A certified arborist assessment, worked to ANSI A300, starts at $250 for a
tree health diagnosis, a risk assessment, or a treatment recommendation before anyone
decides to remove instead of treat. Cabling and bracing is an alternative to removal for a structurally weak tree with a split union or a storm-prone lean. It starts with that same $250 to $1,000 assessment, then installs steel cable or support rods instead of taking the tree down. Tree fertilization for a nutrient-deficient tree runs $500 to $2,000 or more,
based on a soil test rather than a bag off a store shelf.</p>
<p>The crew also covers brush clearing along fence lines and property edges, and hedge and
shrub trimming priced at the visit for boxwood, holly and foundation plantings. Tree
planting includes species selection and correct root flare depth rather than whatever's on
sale, and tree transplanting moves an established tree by tree spade rather than removing
it outright when it's worth saving. Debris hauling and wood chip removal is often included
in a $500 removal, or priced on its own when a homeowner already has cut wood to clear.
Bush hogging flattens overgrown pasture, fence lines and rural acreage with a rotary
cutter, far faster than hand clearing. Commercial tree service covers removal, trimming, stump grinding and land clearing for multi-tenant and business properties. It's scoped at a site walk-through that accounts for tenant access and the hours the property can tolerate a crew on site. A certificate of insurance goes to the property manager or general
contractor before the crew arrives. Ask about any of it when you call.</p>`;
const secWhyTrees = `<h2>Why Hickory Trees Need Professional Care, Not a Weekend Job</h2>
<p>Hickory gets about 45 inches of rain a year over roughly 107 days, and most yards here sit
on sandy loam. Sandy loam drains faster than clay, but it still saturates during a
sustained rain, and it holds a tree's roots less firmly than denser soil once the ground is
wet through. That combination is why mature trees here are more likely to uproot whole
than to just shed a limb in a storm. Catawba County also sees close to 85 freezing days a
year, and each freeze-thaw cycle widens any weak branch union or existing trunk defect a
little further. Loblolly pine, common across this area, holds dense, top-heavy growth that
catches wind hard once it's gone too long without thinning, and it's shallow-rooted for its
height on top of that. Water oak and red maple carry a different risk: a codominant trunk
with included bark at the union, which is a structural weak point whether or not the tree
looks healthy from the outside. Knowing which risk applies to which species, and cutting or
rigging accordingly, is the difference between a job that goes as planned and one that
doesn't.</p>`;
const secProcess = `<h2>How a Tree Service Job Runs</h2>
<p>Every job, from a single stump to a multi-acre clearing, follows the same order. First, a
site inspection: the crew looks at the tree's lean, root condition, and proximity to a
structure, fence or power line, or walks the land being cleared to mark what stays. Second,
a written price, before any saw starts and before anything gets cut. Third, the work itself, done with equipment sized to the job. A bucket truck and ground crew handle open-yard removal or trimming, climbing gear and rigging cover anything near a structure, and a crane takes a large or technical drop. Fourth, cleanup: debris hauled or chipped, a stump ground
below grade if you want it gone, and the site left the way it was found aside from the tree
that came down. Nothing about that order changes for an emergency call. It just compresses,
because the assessment and the written price still happen before a saw starts, they just
happen faster.</p>`;
const secWhyChoose = `<h2>Why Choose Tree Service Hickory NC</h2>
<p>What separates a good tree job from a bad one usually comes down to five things.</p>
<ul>
<li><strong>Licensed and insured</strong> on every job, residential or commercial.</li>
<li><strong>Free estimates</strong>, with a written price before anything is cut.</li>
<li><strong>One crew for the whole scope</strong>: removal, trimming, stump grinding and land clearing,
  without subcontracting between trades or handing off between crews.</li>
<li><strong>Equipment matched to the job</strong>: a bucket truck and ground crew for open-yard work,
  climbing gear and rigging near a structure or power line, and a crane for large or
  technical drops.</li>
<li><strong>The same pricing everywhere in Catawba County</strong>, with no travel charge added for the
  towns outside Hickory.</li>
</ul>`;
const secServiceArea = `<h2>Service Area</h2>
<p>Tree Service Hickory NC covers Hickory and twelve other Catawba County towns: Conover,
Newton, Longview, Maiden, Claremont, Catawba, Sherrills Ford, Terrell, Mountain View, St
