---
/* THE HOMEPAGE — the site's strongest page, and treated as a money page.

   ⚠️ HARD RULE: the body of this page links to the THREE MONEY PAGES AND
   NOTHING ELSE (tree-removal, tree-trimming, emergency-storm-damage-tree-removal).
   Every other service is named and photographed in prose but never linked, per
   Page Templates §2a and Kayla's 2026-09-07 confirmation (see STATUS.md).
   Long-tail and main service pages are reached from the nav and from the
   money pages, never from here.

   Rebuilt 2026-09-07 to the new standing homepage template (Kayla, 2026-09-07):
   opener (no pricing, sells services + local differentiator) → Why Choose (6) →
   residential services w/ photos (6, 3 linked) → commercial services w/ photos (3) →
   ONE pricing table (the only place pricing appears on this page) → hyper-local
   species section → emergency-call process → service area → FAQ → close.
   Content is HAND-PORTED from copy/homepage.md (2,612 words) — edit that file
   first, then this one, if the copy changes. Do not retype prose here from
   scratch. */
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import LocationsBand from '../components/LocationsBand.astro';
import Faq from '../components/Faq.astro';
import { SITE, IMAGES, CALL_CTA, SHOW_CALL_CTA } from '../config';

const heroStyle = `background-image:linear-gradient(rgba(15,26,18,.62),rgba(15,26,18,.72)),url('${IMAGES.heroLanding.src}')`;
const bandStyle = `background-image:linear-gradient(rgba(15,26,18,.62),rgba(15,26,18,.74)),url('${IMAGES.storm.src}')`;

/* 1 — opener. No pricing. Sells the service and the local differentiator
   (species + climate), not the species name alone (fixes the old
   "Why Hickory Trees" heading that read as the tree species, not the city).
   Tone pass 2026-09-07: shorter sentences, benefit-first, "best"/"affordable"
   worked in where they're honest marketing language, not a checkable claim. */
const opener = `<p>Hickory and Catawba County's most trusted choice for tree removal, trimming and storm
cleanup. Whether it's a standing dead pine leaning toward a fence, a storm-split maple, or
a tree already resting on your roof, our crew inspects the job first, then hands you a
real, affordable price in writing before a single cut is made.</p>
<p>Hickory's sandy soil and heavy seasonal rain make trees here more likely to uproot
outright than just drop a limb, and every species fails differently. That's exactly why
homeowners and property managers across Catawba County call us first: we know which trees
are the real risk, and we handle them right the first time. Licensed, insured, and priced
fairly on every job.</p>
<p class="cta-row"><a class="cta" href="#quote">Get Your Free Estimate</a> <a class="cta ghost" href="tel:+18285229430">Call (828) 522-9430</a></p>`;

/* 1b — three-stat trust band, styled like the Pasadena/drywall reference site
   Kayla pointed to (98% / 100% / 20+ style callouts). Numbers here are all
   non-checkable/GREEN per the Trust Signal Rule — no fabricated percentages. */
const trustStats = [
  { n: 'Licensed &', n2: 'Insured', p: 'On every residential and commercial job' },
  { n: 'Free', n2: 'Estimates', p: 'Written price before a single cut, every time' },
  { n: '13', n2: 'Towns Served', p: 'One fair price across all of Catawba County' },
];

/* 2 — why choose, 6 reasons, grounded in FACTS.md / config.ts, no unverifiable claims.
   Tone pass: benefit-first openers, shorter sentences. */
const whyChoose = [
  { h: 'Local Tree and Climate Experts', p: `We work from what actually happens to trees in Hickory's sandy soil and heavy seasonal rain, not a generic checklist. Loblolly pine, water oak, red maple and sweetgum each fail differently — we know which risk applies before a saw ever starts.` },
  { h: 'The Best Price Is a Written Price', p: `Every job gets a real, affordable number in writing, based on what we see on site, not a phone guess. Free estimates on every call, whether it's one stump or a multi-acre clearing.` },
  { h: 'The Right Equipment for the Job', p: `A bucket truck and ground crew for open-yard work, climbing gear and rigging near a structure or power line, and a crane for the big or technical drops. The equipment gets matched to the tree, not the other way around.` },
  { h: 'ISA-Certified Arborist Assessments', p: `Before any removal decision, a certified arborist assessment (ANSI A300) is available for a tree that's stressed rather than obviously dead — a real second opinion, not an upsell.` },
  { h: 'Licensed and Insured, Every Time', p: `Full coverage on a single-family lot or a multi-tenant commercial property, with a certificate of insurance sent to your property manager or GC on request before the crew arrives.` },
  { h: 'One Fair Price, All of Catawba County', p: `Hickory, Conover, Newton, Longview, Maiden, Claremont and the rest of Catawba County get the same affordable pricing and the same crew — no travel charge, ever.` },
];

/* 3 — residential services, 6 items with a photo each. Only the first three
   (the money pages) are linked — see hard rule above. No pricing here. */
const residentialServices = [
  { h: 'Tree Removal', slug: '/tree-removal/', img: 'removal' as const,
    p: `Fast, affordable tree removal for open yards, tight spots beside a house or power line, and large or hazardous trees needing a crane. We inspect first, quote in writing, then get it done — stump ground the same day if you want it gone, everything hauled before we leave.` },
  { h: 'Tree Trimming', slug: '/tree-trimming/', img: 'trimming' as const,
    p: `Structural pruning, canopy thinning, deadwood removal, and clean clearance away from your roof or the power lines. A properly thinned canopy is what lets a mature tree survive a storm instead of losing a limb — or worse.` },
  { h: 'Emergency Storm Damage Removal', slug: '/emergency-storm-damage-tree-removal/', img: 'storm' as const,
    p: `A tree down on your roof, car or driveway gets a safety assessment before a single cut, so nothing shifts the wrong way. Fast response, every time — see how we handle an emergency call below.` },
  { h: 'Stump Grinding', slug: null, img: 'stump' as const,
    p: `Ground flush below grade, whether it's from today's removal, an old one, or work another crew left behind. One stump or several on the same property, same visit.` },
  { h: 'Land Clearing', slug: null, img: 'landClearing' as const,
    p: `Build site, driveway or pasture — cleared tree by tree, not pushed in bulk, so what you want kept stays kept. Debris hauled or chipped as part of the job.` },
  { h: 'Hazardous Tree Removal', slug: null, img: 'hazardous' as const,
    p: `A standing dead or leaning tree gets a real risk assessment before we touch it — lean, root condition, what's nearby. Our most technical removal call, handled with the rigging and crane work it actually needs.` },
];

/* 4 — commercial services, same pattern, 3 items, none linked. */
const commercialServices = [
  { h: 'Commercial Tree Removal and Trimming', img: 'commercial' as const,
    p: `The same reliable removal and trimming work, scoped around your tenants and your hours. A site walk-through comes first, so the crew works around your schedule, not the other way around.` },
  { h: 'Commercial Land and Lot Clearing', img: 'landClearing' as const,
    p: `Build sites and undeveloped lots cleared tree by tree, with what stays marked ahead of time — the same trusted process, sized for a larger property.` },
  { h: 'Certificate of Insurance on Every Job', img: 'arborist' as const,
    p: `Your property manager or GC gets a certificate of insurance before the crew ever sets foot on site — automatically, no chasing us down for it.` },
];

/* 5 — the ONE pricing table on this page. Every number matches PRICING/SITE
   in config.ts. */
const pricingRows = [
  { job: 'Tree Removal', range: '$500 – $3,000+', variables: 'Tree size, lean, access' },
  { job: 'Tree Trimming', range: '$500 – $2,500', variables: 'Scope, tree size, climbing difficulty' },
  { job: 'Emergency / Storm Damage Removal', range: '$2,000 – $20,000', variables: 'Damage extent, access' },
  { job: 'Stump Grinding', range: '$150+', variables: 'Stump size, number of stumps' },
  { job: 'Land Clearing', range: '$2,500 – $12,000+ per acre', variables: 'Vegetation density, site access' },
  { job: 'Hazardous Tree Removal', range: '$500 – $9,000+', variables: 'Lean, proximity to structure' },
  { job: 'Certified Arborist Assessment', range: '$250 – $1,000', variables: 'Diagnosis scope' },
];

/* 6 — hyper-local species section. Kayla, 2026-09-07: "6 or 8 boxes, not an
   odd number that leaves a gap in the grid" — trimmed from 7 to 6 (cut River
   Birch, the thinnest/lowest-risk entry) rather than pad a weak 8th. */
const localSpecies = [
  { h: 'Loblolly Pine', p: `Southern pine beetle turns needles brown from the top down and leaves white "popcorn" pitch tubes on the bark; once infested, a tree is usually dead within weeks and removal is the standard guidance. Shallow-rooted for its height and prone to blowover after heavy rain.` },
  { h: 'White Oak, Red Oak and Water Oak', p: `Oak wilt causes rapid crown wilting and bronzing with patchy leaf drop; removal is recommended quickly to stop the beetle-vectored spread to nearby oaks. Water oak in particular can be hollow inside while still looking healthy from the outside.` },
  { h: 'Red Maple', p: `Verticillium wilt causes sudden branch death. Shallow, aggressive roots and codominant stems with included bark are a structural weak point, and this species is known to split down the middle in wind or ice.` },
  { h: 'Tulip Poplar', p: `Tall and fast-growing with brittle limbs, commonly among the species most vulnerable to wind and storm limb failure.` },
  { h: 'Sweetgum', p: `Stringy, twisted grain that behaves unpredictably during felling, and root suckers can persist for years after removal.` },
  { h: 'Hickory (Carya species)', p: `Powdery mildew and canker diseases are common locally, and bark beetles also target hickories.` },
];

/* 7b — "why hire a professional" benefits grid — Kayla's reference-site
   pattern (the drywall site's 4-icon benefits box). Grounded in the same
   confirmed facts as the Why Choose section, just reformatted for this spot. */
const proBenefits = [
  { h: 'Avoids Costly Mistakes', p: `A wrong cut on a leaning or storm-damaged tree can total a roof or a fence. Professional rigging and load assessment is what a DIY chainsaw job skips.` },
  { h: 'Proper Equipment', p: `Bucket trucks, climbing rigs and cranes handle what a homeowner's ladder and chainsaw can't reach safely.` },
  { h: 'Licensed and Insured', p: `Coverage protects your property if something goes wrong — a certificate of insurance is available on request before work starts.` },
  { h: 'Long-Term Tree Health', p: `Correct pruning cuts and species-aware decisions keep the trees you're keeping healthier, not just the ones coming down.` },
];

/* 7 — how an emergency call runs. */
const emergencySteps = [
  { h: 'Phone Assessment', p: `A quick description of what the tree is doing and what's nearby, plus a photo if there's one, tells the crew whether it's a tree already down and clear, or one still resting against a structure, a car or a power line.` },
  { h: 'On-Site Safety Check', p: `Before a single cut is made, the crew assesses the load the tree is putting on whatever it landed on. Cutting the wrong piece first can drop the load the wrong way, so this step happens every time, storm call or not.` },
  { h: 'Controlled Removal', p: `The tree comes down in the order the assessment calls for: rigged and sectioned near a structure or line, dropped in one piece if the yard is open.` },
  { h: 'Cleanup and Debris Hauling', p: `Everything cut gets hauled or chipped before the crew leaves, and the site is left the way it was found aside from the tree that came down.` },
];

/* 8 — insurance-claim support. Kayla, 2026-09-08, sent sourced general facts
   (SOURCED in FACTS.md § Insurance, 2026-09-08) on how NC homeowners insurance
   actually treats tree damage — used here as general information, which also
   answers real "does insurance cover tree removal" search intent.
   ⚠️ Still NOT claimed: direct insurance billing, working with named carriers
   or adjusters, or any turnaround-time promise — none of that is confirmed.
   A dedicated insurance page is a separate build, flagged in the report. */
const secInsurance = `<h2>Does Insurance Cover Tree Removal in Hickory, NC?</h2>
<p>Usually, only if the tree damaged an insured structure — a house, garage or fence.
Coverage for the removal itself is typically capped around $500 to $1,000 per tree. A
tree that falls in the yard and misses every structure is generally not a covered
cleanup cost, and if a neighbor's tree was already dead or dying before it fell on your
property, their liability coverage can come into play instead of yours.</p>
<p>The claims process usually runs: photograph the damage before any cleanup, get a
written estimate from an insured tree service, submit the estimate and photos to your
insurer, then an adjuster reviews it before work is approved. We document every storm
job with photos and an itemized estimate built for that process — ask for it when you
call.</p>`;

const closeBody = `<p>The most trusted, most affordable tree service team in Hickory and the rest of Catawba
County — licensed, insured, and priced in writing before anything is cut.</p>
<p>Call Tree Service Hickory NC at (828) 522-9430, or send the details and we'll come look.</p>`;

const faqs = [
  { q: `How much does tree service cost in Hickory, NC?`, a: `See the table above for typical ranges by service. Every job still gets a written price before a saw starts, so the number is never a surprise once the work begins.` },
  { q: `Do you handle emergency storm damage?`, a: `Yes. A tree down on a house, a car or a driveway gets handled the way access allows. Cost is driven mainly by damage and access rather than a flat rate.` },
  { q: `Do I need a permit to remove a tree on my own property in Hickory?`, a: `No. Ordinary residential tree removal on a single-family or two-family lot does not require a city permit under Hickory's Land Development Code. A permit applies only to a tree in a public right-of-way or a job tied to new commercial construction, and we handle that permit when it's needed.` },
  { q: `What towns do you serve?`, a: `Hickory and the rest of Catawba County. No separate travel charge applies to the towns outside Hickory.` },
  { q: `Are you licensed and insured?`, a: `Yes, on every job, residential and commercial.` },
  { q: `What's the difference between tree trimming and tree removal?`, a: `Trimming cuts back limbs and leaves the tree standing. Removal takes the whole tree down. A tree that looks stressed rather than obviously dead is usually a trimming or an assessment question first, not an automatic removal.` },

  { q: `Do you grind stumps left behind by another crew?`, a: `Yes, single stumps, several from the same removal, or ones another crew left. All of them get ground flush below grade.` },
  { q: `What does land clearing cost in Hickory?`, a: `See the table above. Every job starts with a walk of the property to mark what stays and what comes out, then a written price by the acre.` },
  { q: `Do you offer certified arborist assessments?`, a: `Yes. An ISA-certified arborist assessment, worked to ANSI A300, covers a tree health diagnosis, a risk assessment, or a written treatment recommendation before anyone decides to remove instead of treat.` },
  { q: `Why do trees uproot here instead of just losing limbs?`, a: `Sandy loam soil drains fast but still saturates during Hickory's roughly 45 inches of annual rain, which loosens root anchorage on a saturated lot. A shallow-rooted species like loblolly pine is the most common one this affects.` },
  { q: `How do I know which service I need before scheduling a visit?`, a: `A short description of what the tree looks like and what's near it, plus a photo if you have one, is usually enough over the phone to point you toward removal, trimming, an assessment, or cabling and bracing before a crew ever comes out.` },
  { q: `Do you offer financing or payment plans for larger jobs?`, a: `Larger jobs like land clearing or a multi-tree removal are quoted as one written price before work starts. Payment terms for a job that size get discussed at the estimate, not assumed ahead of time.` },
  { q: `What happens to the wood after a tree comes down?`, a: `Debris hauling and chipping is part of most removals. Larger trunk sections can sometimes be left on site if you want the firewood, which is worth mentioning at the estimate.` },
  { q: `Does homeowners insurance cover tree removal in North Carolina?`, a: `Usually only if the tree damaged an insured structure like a house, garage or fence — coverage for the removal itself is commonly capped around $500 to $1,000 per tree. A tree that falls in the yard and misses every structure is generally not a covered cost.` },
];
---
<BaseLayout
  title={`Tree Service Hickory NC | Removal, Trimming & Storm Damage`}
  description="Tree Service Hickory NC covers removal, trimming and storm damage across Catawba County. Licensed and insured, free estimates, ISA-certified arborist assessments available."
  business={true}
  faqs={faqs}
>

  {/* 1 — opener. No pricing. Two paragraphs plus CTA buttons, then the form, both above the fold. */}
  <section class="hero" style={heroStyle}>
    <div class="wrap">
      <div class="hero-grid">
        <div class="hcard">
          <span class="tag">REMOVAL · TRIMMING · STORM DAMAGE</span>
          <h1>Tree Service in Hickory, NC</h1>
          <div class="lede" set:html={opener} />
        </div>
        <QuoteForm heading="Get a Free Estimate" source="homepage" />
      </div>
    </div>
  </section>

  {/* 1b — three-stat trust band (Kayla's reference-site pattern). */}
  <section class="stat-band">
    <div class="wrap stat-grid">
      {trustStats.map(s => (
        <div class="stat">
          <div class="stat-n">{s.n}<br/>{s.n2}</div>
          <p>{s.p}</p>
        </div>
      ))}
    </div>
  </section>

  {/* 2 — why choose, 6 reasons. */}
  <section class="cream tight">
    <div class="wrap">
      <article class="prose narrow">
        <h2>Why Choose the Best Tree Service in Hickory, NC</h2>
        <div class="feature-grid">
          {whyChoose.map(item => (
            <div class="feature">
              <h3>{item.h}</h3>
              <p>{item.p}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  {/* 3 — residential services, 6 with photos, only 3 linked (the money pages). */}
  <section class="tight">
    <div class="wrap">
      <article class="prose">
        <h2>Professional Tree Care and Removal Services in Hickory, NC</h2>
        <div class="service-grid">
          {residentialServices.map(item => (
            <div class="service-card">
              <div class="ph">
                <img src={IMAGES[item.img].src} alt={IMAGES[item.img].alt} width="1600" height="1000" loading="lazy" />
              </div>
              <h3>{item.slug ? <a href={item.slug}>{item.h}</a> : item.h}</h3>
              <p>{item.p}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  {/* 3b — photo band CTA, no pricing, no filler ("one crew" language removed). */}
  <section class="photoband" style={bandStyle}>
    <div class="inner">
      <div class="band-card">
        <div class="t2">Not sure what your tree actually needs?</div>
        <p>Tell us what it looks like and where it stands. You'll get a written price and a real
        timeline on site from the area's most trusted crew — the estimate is free either way.</p>
        <p style="margin-top:20px"><a class="cta" href="#quote">Get Your Free Estimate</a></p>
      </div>
    </div>
  </section>

  {/* 4 — commercial services, same pattern, 3 items, none linked. */}
  <section class="cream tight">
    <div class="wrap">
      <article class="prose">
        <h2>Expert Commercial Tree Services in Hickory, NC</h2>
        <div class="service-grid">
          {commercialServices.map(item => (
            <div class="service-card">
              <div class="ph">
                <img src={IMAGES[item.img].src} alt={IMAGES[item.img].alt} width="1600" height="1000" loading="lazy" />
              </div>
              <h3>{item.h}</h3>
              <p>{item.p}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  {/* 5 — the ONE pricing table on the homepage. */}
  <section class="tight">
    <div class="wrap">
      <article class="prose narrow">
        <h2>Affordable Tree Service Pricing in Hickory, NC</h2>
        <p>Straightforward, honest ranges — no surprises, no upsells. Every job still gets a
        written price before a saw starts, and every price below reflects our commitment to
        fair, affordable rates across Catawba County.</p>
        <table class="pricing-table">
          <thead>
            <tr><th>Service</th><th>Typical Price Range</th><th>Key Variables</th></tr>
          </thead>
          <tbody>
            {pricingRows.map(row => (
              <tr><td>{row.job}</td><td>{row.range}</td><td>{row.variables}</td></tr>
            ))}
          </tbody>
        </table>
      </article>
    </div>
  </section>

  {/* 6 — hyper-local species section. */}
  <section class="cream tight">
    <div class="wrap">
      <article class="prose narrow">
        <h2>Trees We Watch Most Closely in Hickory, NC</h2>
        <p>Hickory's sandy loam drains fast but still saturates during the area's heavy annual
        rain. Freezing winters widen weak branch unions a little further each year. That's why
        species matters as much as size here — these are the ones our crew watches for most.</p>
        <ul class="species-list">
          {localSpecies.map(item => (
            <li><strong>{item.h}</strong><span>{item.p}</span></li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  {/* 7 — how an emergency call runs. */}
  <section class="tight">
    <div class="wrap">
      <article class="prose narrow steps">
        <h2>How Tree Service Hickory NC Handles an Emergency Call</h2>
        <ol>
          {emergencySteps.map(item => (
            <li><strong>{item.h}.</strong> {item.p}</li>
          ))}
        </ol>
      </article>
    </div>
  </section>

  {/* 7b — why hire a professional, 4-box benefits grid (Kayla's reference-site pattern). */}
  <section class="cream tight">
    <div class="wrap">
      <article class="prose narrow">
        <h2>Benefits of Hiring a Professional Tree Service</h2>
        <div class="benefits-grid">
          {proBenefits.map(item => (
            <div class="benefit">
              <h3>{item.h}</h3>
              <p>{item.p}</p>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  {/* 8 — insurance-claim support (Kayla, 2026-09-08). A dedicated insurance
      page is a separate build, flagged in the report, not built here. */}
  <section class="tight">
    <div class="wrap">
      <article class="prose narrow" set:html={secInsurance} />
    </div>
  </section>

  {/* 9 — service area band, FAQ, close. Only ONE service-area section now —
      the earlier plain-prose duplicate of this band was cut, 2026-09-08. */}
  <LocationsBand bg="landClearing" linked={false} />

  <Faq items={faqs} heading="Tree Service Questions We Get Asked in Hickory" />

  <section class="close">
    <div class="wrap">
      <div class="t2">Get Your Tree Service Job Quoted</div>
      <div set:html={closeBody} />
      {SHOW_CALL_CTA && (
        <div class="cta-row" style="margin-top:24px">
          <a class="cta" href={CALL_CTA.href}>{CALL_CTA.label}</a>
          <a class="cta ghost" href="#quote">Get a Free Estimate</a>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
